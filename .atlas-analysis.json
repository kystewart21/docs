  "keyFeatures": [
    "Hosted MCP server at https://mcp.opentweet.io/mcp with 43 tools — works with Claude, Cursor, Windsurf, ChatGPT, and any MCP client",
    "REST API with Bearer token auth — POST to X from any language with no X developer account",
    "CLI tool (@opentweet/cli) for terminal and CI/CD pipeline posting",
    "Visual calendar with drag-and-drop scheduling and best-time heatmap",
    "Thread scheduling up to 25 parts with per-tweet media",
    "Cross-posting to X, Bluesky, and LinkedIn from a single draft",
    "Evergreen queue that recycles best-performing posts on a configurable cooldown",
    "Smart Connectors: RSS, GitHub, Stripe, SaaS, and custom API feeds",
    "AI Studio with seven model choices for post generation and voice learning",
    "X Articles: write in markdown, schedule alongside regular posts",
    "DM Campaigns with human-in-the-loop approval and official API delivery",
    "Analytics: impressions, engagement rate, growth, and best-time recommendations"
  ],
